---
// src/pages/portfolio.astro
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <Header />

  <main class="min-h-screen py-8 md:pt-stack-lg md:pb-stack-lg">
    
    <!-- ЗАГОЛОВОК СТРАНИЦЫ -->
    <section class="px-4 md:px-grid-margin mb-8 md:mb-stack-lg">
      <h1 class="font-display text-4xl md:text-[64px] lg:text-display uppercase leading-[0.85] border-l-8 border-primary pl-4 md:pl-6">
        АВТОМАТИЗАЦИЯ<br/><span class="text-secondary italic">ИИ-АГЕНТЫ</span>
      </h1>
      <p class="font-code text-sm md:text-lg uppercase mt-4 md:mt-6 text-on-surface-variant max-w-2xl">
        [ ПОРТФОЛИО: ИИ-АГЕНТЫ, АВТОМАТИЗАЦИЯ И ТЕЛЕГРАМ-ЭКОСИСТЕМА ]
      </p>
    </section>

    <!-- ПРОЕКТ 01: ИИ Консультант -->
    <section class="px-4 md:px-grid-margin py-8 md:py-stack-md border-y-4 border-on-surface bg-surface-bright mb-8 md:mb-stack-lg group">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 md:gap-12 items-center">
        
        <button
          type="button"
          onclick="window.toggleChat && window.toggleChat()"
          aria-label="Открыть чат с ИИ-консультантом"
          class="group relative border-4 border-on-surface h-full min-h-[250px] md:min-h-[400px] bg-[#ffea00] hard-shadow flex flex-col items-center justify-center gap-4 md:gap-6 p-6 md:p-8 order-last lg:order-first overflow-hidden cursor-pointer text-center transition-transform hover:translate-x-[4px] hover:translate-y-[4px] hover:shadow-none active:translate-x-[6px] active:translate-y-[6px]"
        >
          <div class="absolute inset-0 custom-grid-bg opacity-20 pointer-events-none"></div>

          <span class="relative z-10 font-code text-[10px] md:text-xs font-bold uppercase tracking-wider bg-white border-2 border-on-surface px-3 py-1">
            [ Живой ИИ-консультант ]
          </span>

          <span class="relative z-10 font-display text-[clamp(2rem,9vw,3.5rem)] md:text-[3.5rem] xl:text-6xl uppercase leading-[0.85] font-black text-on-surface">
            Разбудить<br/>
            <span class="text-transparent" style="-webkit-text-stroke: 2px var(--color-on-surface, #000);">ИИ</span>
          </span>

          <span class="relative z-10 inline-flex items-center justify-center gap-2 font-code text-[10px] md:text-xs uppercase font-black bg-on-surface text-surface px-4 py-2.5 border-2 border-on-surface">
            Открыть чат
            <span class="material-symbols-outlined !text-base">north_east</span>
          </span>

          <div class="absolute -right-6 -bottom-6 text-on-surface opacity-10 pointer-events-none">
            <span class="material-symbols-outlined !text-[140px] md:!text-[200px] leading-none">forum</span>
          </div>
        </button>

        <div class="flex flex-col gap-4 md:gap-6 p-4 md:p-8">
          <div class="flex flex-wrap gap-2 md:gap-stack-sm mb-2 md:mb-stack-sm">
            <span class="bg-secondary-container text-white px-2 py-1 md:px-3 md:py-1 border-2 border-on-surface text-[10px] md:text-xs font-bold font-code">PYTHON</span>
            <span class="bg-white px-2 py-1 md:px-3 md:py-1 border-2 border-on-surface text-[10px] md:text-xs font-bold font-code text-on-surface">LANGCHAIN</span>
            <span class="bg-white px-2 py-1 md:px-3 md:py-1 border-2 border-on-surface text-[10px] md:text-xs font-bold font-code text-on-surface">FASTAPI</span>
            <span class="bg-white px-2 py-1 md:px-3 md:py-1 border-2 border-on-surface text-[10px] md:text-xs font-bold font-code text-on-surface">CHROMADB</span>
          </div>
          
          <h2 class="font-headline-lg text-2xl md:text-4xl uppercase leading-none group-hover:italic transition-all">
            01. ИИ-КОНСУЛЬТАНТ НА ВЕБ-САЙТЕ
          </h2>
          
          <div class="font-body-lg text-sm md:text-base lg:text-lg text-on-surface space-y-3 md:space-y-4">
            <p><strong>Задача:</strong> Развернуть автономного ИИ-консультанта для сайта, который отвечает строго по внутренним документам (без галлюцинаций), консультирует по ассортименту и мгновенно передает теплые лиды менеджерам.</p>
            <p><strong>Решение:</strong> Разработана полноценная White-Label SaaS-платформа. Агент самостоятельно парсит PDF-документы и Google-таблицы. Встроен лимитер от спама и защита бюджета API. Администратор получает расшифровки диалогов прямо в Telegram.</p>
          </div>
          
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-2 md:mt-4 border-t-4 border-on-surface pt-4">
            <div>
              <p class="font-code text-xs md:text-sm text-on-surface-variant uppercase">Интеграция на сайт</p>
              <p class="font-display text-xl md:text-2xl text-primary-container-on font-black">1 СТРОЧКА КОДА</p>
            </div>
            <div>
              <p class="font-code text-xs md:text-sm text-on-surface-variant uppercase">Основа данных</p>
              <p class="font-label-bold text-sm md:text-lg">PDF + Google Sheets + Сайты</p>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- ПРОЕКТ 02: Nutri Bot -->
    <section class="px-4 md:px-grid-margin py-8 md:py-stack-md border-b-4 border-on-surface bg-white group">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 md:gap-12 items-center">

        <div class="flex flex-col gap-4 md:gap-6 p-4 md:p-8">
          <div class="flex flex-wrap gap-2 md:gap-stack-sm mb-2 md:mb-stack-sm">
            <span class="bg-primary-container px-2 py-1 md:px-3 md:py-1 border-2 border-on-surface text-[10px] md:text-xs font-bold font-code text-on-surface">TELEGRAM BOT</span>
            <span class="bg-white px-2 py-1 md:px-3 md:py-1 border-2 border-on-surface text-[10px] md:text-xs font-bold font-code text-on-surface">AI COACH</span>
            <span class="bg-white px-2 py-1 md:px-3 md:py-1 border-2 border-on-surface text-[10px] md:text-xs font-bold font-code text-on-surface">VISION LLM</span>
          </div>

          <h2 class="font-headline-lg text-2xl md:text-4xl uppercase leading-none group-hover:italic transition-all">
            02. SMART NUTRI BOT
          </h2>

          <div class="font-body-lg text-sm md:text-base lg:text-lg text-on-surface space-y-3 md:space-y-4">
            <p><strong>Задача:</strong> Создать персонального ИИ-ассистента по здоровому питанию в Telegram, который избавляет пользователя от ручного ведения дневников калорий.</p>
            <p><strong>Решение:</strong> Разработан интерактивный бот на Python (Aiogram + FastAPI). Главная фишка — интеграция мультимодальной модели (Gemini Vision / OpenAI), которая за 3 секунды распознает состав и вес блюда по фотографии. Бот заносит данные в базу SQLite, трекает водный баланс и генерирует рецепты.</p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-2 md:mt-4 border-t-4 border-on-surface pt-4">
            <div>
              <p class="font-code text-xs md:text-sm text-on-surface-variant uppercase">Анализ тарелки по фото</p>
              <p class="font-display text-2xl md:text-3xl text-secondary">~3 сек</p>
            </div>
            <div>
              <p class="font-code text-xs md:text-sm text-on-surface-variant uppercase">Стек решения</p>
              <p class="font-label-bold text-sm md:text-lg">Python + Vision API + SQLite</p>
            </div>
          </div>
        </div>

        <div class="border-4 border-on-surface h-full min-h-[250px] md:min-h-[400px] bg-secondary-container hard-shadow flex items-center justify-center relative overflow-hidden transition-transform group-hover:translate-x-[4px] group-hover:translate-y-[4px] group-hover:shadow-none active:translate-x-[4px] active:translate-y-[4px] active:shadow-none">
          <div class="absolute inset-0 custom-grid-bg opacity-20"></div>
          <img 
            src="/images/NutriBot_cr_2.png" 
            alt="Бот в Telegram, распознающий еду по фото" 
            class="w-full h-full object-cover object-center grayscale group-hover:grayscale-0 transition-all duration-500 scale-105 group-hover:scale-100 group-active:grayscale-0 group-active:scale-100"
          />
        </div>

      </div>
    </section>

    <!-- ПРОЕКТ 03: Система записи под ваш бизнес -->
    <section class="px-4 md:px-grid-margin py-8 md:py-stack-md border-b-4 border-on-surface bg-primary-fixed mb-8 md:mb-stack-lg group">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 md:gap-12 items-center">

        <div class="flex flex-col gap-4 md:gap-6 p-4 md:p-8">
          <div class="flex flex-wrap gap-2 md:gap-stack-sm mb-2 md:mb-stack-sm">
            <span class="bg-primary-container px-2 py-1 md:px-3 md:py-1 border-2 border-on-surface text-[10px] md:text-xs font-bold font-code text-on-surface">TELEGRAM MINI APP</span>
            <span class="bg-white px-2 py-1 md:px-3 md:py-1 border-2 border-on-surface text-[10px] md:text-xs font-bold font-code text-on-surface">ИНДИВИДУАЛЬНАЯ CRM</span>
            <span class="bg-white px-2 py-1 md:px-3 md:py-1 border-2 border-on-surface text-[10px] md:text-xs font-bold font-code text-on-surface">ОНЛАЙН-РАСПИСАНИЕ</span>
          </div>

          <h2 class="font-headline-lg text-2xl md:text-4xl uppercase leading-none group-hover:italic transition-all">
            03. СИСТЕМА ЗАПИСИ ПОД&nbsp;ВАШ&nbsp;БИЗНЕС
          </h2>

          <div class="font-body-lg text-sm md:text-base lg:text-lg text-on-surface space-y-3 md:space-y-4">
            <p><strong>Задача:</strong> Полностью автоматизировать запись и учет клиентов для эндуро-проката, обучения и сервиса. Убрать зависимость от звонков и шаблонных CRM, которые не учитывают групповые заезды, занятость техники и гидов.</p>
            <p><strong>Решение:</strong> Разработана индивидуальная система записи и CRM под конкретные процессы проката: клиентское Telegram Mini App, панель менеджера с календарем заездов и карточками клиентов, канбан сервиса и авто-уведомления. Клиент оформляет бронь в Telegram за пару секунд, а команда получает заявку мгновенно — без компромиссов с шаблонными сервисами.</p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-2 md:mt-4 border-t-4 border-on-surface pt-4">
            <div>
              <p class="font-code text-xs md:text-sm text-on-surface-variant uppercase">Бронь в Telegram</p>
              <p class="font-display text-2xl md:text-3xl text-secondary">~2 сек</p>
            </div>
            <div>
              <p class="font-code text-xs md:text-sm text-on-surface-variant uppercase">Интеграции</p>
              <p class="font-label-bold text-sm md:text-lg">Telegram Mini App + CRM + Уведомления</p>
            </div>
          </div>

          <div class="mt-4">
            <a href="/lizard-trail" class="inline-flex items-center gap-2 bg-on-surface text-surface px-6 py-3 font-label-bold uppercase text-sm md:text-base border-4 border-on-surface hard-shadow hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-none transition-all">
              ИНТЕРАКТИВНОЕ ДЕМО И КЕЙС <span class="material-symbols-outlined">arrow_forward</span>
            </a>
          </div>
        </div>

        <div class="border-4 border-on-surface h-full min-h-[450px] md:min-h-[640px] bg-neutral-200 hard-shadow flex flex-col items-center justify-center relative overflow-hidden transition-transform group-hover:translate-x-[4px] group-hover:translate-y-[4px] group-hover:shadow-none active:translate-x-[4px] active:translate-y-[4px] active:shadow-none py-8 px-4">
          <!-- Фоновый узор -->
          <div class="absolute inset-0 opacity-10 pointer-events-none" style="background-image: radial-gradient(#000 1px, transparent 1px); background-size: 20px 20px;"></div>

          <!-- Переключатель режима симулятора -->
          <div class="flex items-center gap-2 mb-4 z-20">
            <button 
              type="button" 
              data-portfolio-screen="/lizard-demo/index.html" 
              class="portfolio-sim-btn is-active px-3 py-1.5 border-2 border-on-surface font-code text-[11px] md:text-xs font-bold uppercase transition-all bg-primary-container text-on-surface cursor-pointer hard-shadow">
              ГЛАВНАЯ (КЛИЕНТ)
            </button>
            <button 
              type="button" 
              data-portfolio-screen="/lizard-demo/admin.html" 
              class="portfolio-sim-btn px-3 py-1.5 border-2 border-on-surface font-code text-[11px] md:text-xs font-bold uppercase transition-all bg-white hover:bg-neutral-100 text-on-surface cursor-pointer hard-shadow">
              CRM (Менеджер)
            </button>
          </div>

          <!-- Брутальный корпус телефона -->
          <div class="relative w-[300px] sm:w-[320px] h-[560px] sm:h-[600px] bg-white border-4 border-on-surface shadow-[8px_8px_0px_0px_rgba(26,28,28,1)] rounded-[2.5rem] flex flex-col overflow-hidden z-10">
            
            <!-- "Челка" (Динамик и камера) -->
            <div class="absolute top-0 left-1/2 -translate-x-1/2 w-32 h-7 bg-on-surface rounded-b-2xl z-20 flex justify-center items-center gap-2">
              <div class="w-12 h-1.5 bg-neutral-700 rounded-full"></div>
              <div class="w-2 h-2 bg-neutral-700 rounded-full"></div>
            </div>

            <!-- Боковые кнопки (Имитация) -->
            <div class="absolute top-32 -right-5 w-1 h-16 bg-on-surface rounded-r-md"></div>
            <div class="absolute top-24 -left-5 w-1 h-10 bg-on-surface rounded-l-md"></div>
            <div class="absolute top-40 -left-5 w-1 h-10 bg-on-surface rounded-l-md"></div>

            <!-- Iframe с Mini App -->
            <iframe 
              id="portfolio-sim-iframe"
              src="/lizard-demo/index.html" 
              class="w-full h-full border-none bg-white pt-7"
              title="Демо: система записи под ваш бизнес"
              loading="lazy">
            </iframe>
          </div>
        </div>

      </div>
    </section>

  </main>

  <Footer />

  <script>
    // Логика переключения режима симулятора «Система записи под ваш бизнес» на странице портфолио
    const portSimBtns = document.querySelectorAll<HTMLButtonElement>('.portfolio-sim-btn');
    const portSimIframe = document.getElementById('portfolio-sim-iframe') as HTMLIFrameElement;

    portSimBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const screen = btn.getAttribute('data-portfolio-screen');
        if (!screen || !portSimIframe) return;

        portSimBtns.forEach((b) => {
          b.classList.remove('is-active', 'bg-primary-container');
          b.classList.add('bg-white');
        });
        btn.classList.add('is-active', 'bg-primary-container');
        btn.classList.remove('bg-white');

        portSimIframe.src = screen;
      });
    });
  </script>
</Layout>